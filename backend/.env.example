DATABASE_URL=sqlite:///./placement_prep.db
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# --- LLM providers ---
# Groq is primary (free tier is ~14,400 requests/day vs Gemini's measured 20).
# It speaks the OpenAI chat-completions API. Get a key at console.groq.com.
# Model ids churn — check GET https://api.groq.com/openai/v1/models before
# pinning one; a retired id returns 404.
GROQ_API_KEY=
# Measured: 1000 requests/day per model, 12,000 TPM on llama-3.3-70b-versatile
# and 8,000 TPM on the gpt-oss pair. Don't add qwen/qwen3.6-27b — it emits its
# <think> reasoning inside the reply.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Gemini is kept as an automatic fallback: if Groq is down or out of quota the
# interview keeps working. Leave blank to run Groq-only.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
# The free tier's daily cap is PER MODEL (measured: 20 requests/day for
# gemini-3.6-flash), so when the primary is spent these are tried in order,
# each with its own fresh allowance. Comma-separated.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Email verification. Leave RESEND_API_KEY blank to run in dev mode (the code is
# logged to the server console). Set it to send real emails via Resend;
# EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=
EMAIL_FROM=PlacementPrep <onboarding@resend.dev>
# DEV/DEMO: fixed verification code, no email sent. Empty it (DEV_VERIFICATION_CODE=)
# to switch to real random codes emailed via Resend. Turn OFF in production.
DEV_VERIFICATION_CODE=123456
# Social sign-in (leave blank to disable a provider). See OAUTH_SETUP.md for how
# to create the apps and which redirect URIs to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where providers redirect back — this backend's own base URL. Use the Fly URL
# in production. Must exactly match the redirect URI registered in each console.
OAUTH_REDIRECT_BASE=http://localhost:8000
CORS_ORIGINS=["*"]
