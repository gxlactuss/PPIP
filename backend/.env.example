# App log level (DEBUG, INFO, WARNING, ERROR); uvicorn's own logs use --log-level
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./placement_prep.db
# Required; startup fails if empty, a placeholder, or under 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
RESEND_API_KEY=
EMAIL_FROM=PlacementPrep <onboarding@resend.dev>
# Local dev only (fixed OTP, no email); must be empty in production, and startup fails if set together with RESEND_API_KEY
DEV_VERIFICATION_CODE=123456
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
# Only needed for browser clients (the iOS app ignores CORS); list exact origins, e.g. ["https://app.example.com"]
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false
# Auth rate limits (";"-separated). In-memory counters reset on restart and are not
# shared across machines; use a redis:// URI before scaling past one machine.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute;30/hour
RATE_LIMIT_SIGNUP=3/minute;20/hour
RATE_LIMIT_VERIFY=5/minute;20/hour
RATE_LIMIT_RESEND_VERIFICATION=1/minute;5/hour
RATE_LIMIT_OAUTH=20/minute
RATE_LIMIT_DELETE_ACCOUNT=5/hour
