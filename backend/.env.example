DATABASE_URL=sqlite:///./placement_prep.db
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
# Email verification. Leave RESEND_API_KEY blank to run in dev mode (the code is
# logged to the server console). Set it to send real emails via Resend;
# EMAIL_FROM must be a Resend-verified sender.
RESEND_API_KEY=
EMAIL_FROM=PlacementPrep <onboarding@resend.dev>
# DEV/DEMO: fixed verification code, no email sent. Empty it (DEV_VERIFICATION_CODE=)
# to switch to real random codes emailed via Resend. Turn OFF in production.
DEV_VERIFICATION_CODE=123456
# Social sign-in (leave blank to disable a provider). See OAUTH_SETUP.md for how
# to create the apps and which redirect URIs to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where providers redirect back — this backend's own base URL. Use the Fly URL
# in production. Must exactly match the redirect URI registered in each console.
OAUTH_REDIRECT_BASE=http://localhost:8000
CORS_ORIGINS=["*"]
